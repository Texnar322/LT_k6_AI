# ---------------- Stress test ----------------
STRESS_HTTP_RATE=10
STRESS_KAFKA_RATE=10
STRESS_DURATION=10m

# ---------------- Reliability test ----------------
RELIABILITY_HTTP_RATE=5
RELIABILITY_KAFKA_RATE=5
RELIABILITY_DURATION=24h

# VU allocation is per script/scenario.
HTTP_PREALLOCATED_VUS=20
HTTP_MAX_VUS=100
KAFKA_PREALLOCATED_VUS=20
KAFKA_MAX_VUS=100

# ---------------- Batch mode ----------------
BATCH_MESSAGES_PER_TOPIC=100000
BATCH_KAFKA_VUS_PER_TOPIC=10
BATCH_MAX_DURATION=6h

TEST_RUN_ID=alfagen-perf-local
