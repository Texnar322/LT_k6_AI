# ---------------- Kafka ----------------
KAFKA_BROKERS=localhost:9092
# PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
# NONE | PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=dev
KAFKA_SASL_PASSWORD=

KAFKA_TOPIC_01=alfagen.loadtest.topic01
KAFKA_TOPIC_02=alfagen.loadtest.topic02
KAFKA_TOPIC_03=alfagen.loadtest.topic03
KAFKA_TOPIC_04=alfagen.loadtest.topic04
KAFKA_TOPIC_05=alfagen.loadtest.topic05
KAFKA_TOPIC_06=alfagen.loadtest.topic06
KAFKA_TOPIC_07=alfagen.loadtest.topic07
KAFKA_TOPIC_08=alfagen.loadtest.topic08
KAFKA_TOPIC_09=alfagen.loadtest.topic09
KAFKA_TOPIC_10=alfagen.loadtest.topic10

KAFKA_CA_FILE=
KAFKA_CLIENT_CERT_FILE=
KAFKA_CLIENT_KEY_FILE=
KAFKA_TLS_SKIP_VERIFY=false
KAFKA_AUTO_CREATE_TOPIC=false
KAFKA_REQUIRED_ACKS=1
KAFKA_WRITE_TIMEOUT_MS=10000

# ---------------- Maximum / step test ----------------
MAX_HTTP_START_RATE=1
MAX_HTTP_STEP_RATE=5
MAX_HTTP_MAX_RATE=25
MAX_KAFKA_START_RATE=1
MAX_KAFKA_STEP_RATE=5
MAX_KAFKA_MAX_RATE=25
